# Copy this file to .env and fill in the values. Never commit .env.
# See docs/prototype.md for how to get each value.

# Stop components from contacting their vendors (ADR-0005).
CHECKPOINT_DISABLE=1
BETTER_AUTH_TELEMETRY=0

# Database and notifications (deploy/compose/docker-compose.yml).
DATABASE_URL=postgresql://opificia:opificia@127.0.0.1:5432/opificia
# Optional. Without it, live updates fall back to polling PostgreSQL.
VALKEY_URL=redis://127.0.0.1:6380

# Authentication. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL people use in the browser. In development the web app proxies /api.
BETTER_AUTH_URL=http://localhost:5173

# GitHub App (see docs/prototype.md). The callback URL of the App must be
# http://localhost:5173/api/auth/callback/github for GitHub sign-in.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
# Comma-separated emails of the people who may link the App's installations
# to an organisation. Nobody else can claim your repositories.
OPIFICIA_OPERATOR_EMAILS=

# Your own Anthropic API key. It stays in the control plane and never enters a
# sandbox.
ANTHROPIC_API_KEY=

# Optional settings, shown with their defaults.
# OPIFICIA_ROLE=all                 # api, worker or all
# PORT=3000                         # API for the web app
# OPIFICIA_SANDBOX_PORT=3001        # runner protocol and model proxy for sandboxes
# OPIFICIA_SANDBOX_BIND=0.0.0.0     # sandboxes reach it through the Docker host
# OPIFICIA_DATA_DIR=.data           # repository caches and run files
# OPIFICIA_SANDBOX_IMAGE=opificia/harness-claude:dev
# OPIFICIA_TRIGGER_LABEL=opificia
# OPIFICIA_POLL_INTERVAL_SECONDS=30
# OPIFICIA_RUN_BUDGET_USD=15
# OPIFICIA_RUN_TIMEOUT_MINUTES=60
# OPIFICIA_PLAN_MODEL=claude-opus-5-5
# OPIFICIA_IMPLEMENT_MODEL=claude-sonnet-5-5
# OPIFICIA_MAX_MODEL_REQUESTS=400   # per sandbox stage, enforced by the model proxy
# OPIFICIA_SIGNUP=open              # set to closed once you have created your account
# What the implementation stage may reach (ADR-0007): none, registries or open.
# "registries" allows package registries and source hosts on a built-in list,
# through the egress proxy in the gateway. Planning never has network access.
# OPIFICIA_SANDBOX_NETWORK=registries
# Hosts allowed on top of the built-in list, comma-separated; ".example.org"
# includes its subdomains. The deny list wins over this list.
# OPIFICIA_EGRESS_ALLOW=
# OPIFICIA_GIT_AUTHOR_NAME=Opificia
# The only author and committer email the agent's commits may carry. For a
# repository that uses sign-off by approval (ADR-0006), use the bot address of
# the GitHub App that opens the pull requests, for example
# 12345+opificia[bot]@users.noreply.github.com. Only commits by the bot that
# opened a pull request can receive a maintainer's sign-off.
# OPIFICIA_GIT_AUTHOR_EMAIL=opificia@localhost
