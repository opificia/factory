# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[{LICENSE,LICENSES/*}]
# Licence texts are kept exactly as published.
trim_trailing_whitespace = false
insert_final_newline = unset
indent_style = unset
indent_size = unset

[brand/**]
# Logo files are copied unchanged from the brand book. Do not reformat them.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
