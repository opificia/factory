{
  "name": "@opificia/server",
  "version": "0.0.0",
  "private": true,
  "description": "Opificia control plane: API and worker",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "CHECKPOINT_DISABLE=1 prisma generate && nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:generate": "CHECKPOINT_DISABLE=1 prisma generate",
    "db:migrate": "CHECKPOINT_DISABLE=1 prisma migrate dev",
    "db:deploy": "CHECKPOINT_DISABLE=1 prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@octokit/auth-app": "^8.3.1",
    "@opificia/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.8",
    "dockerode": "^5.0.1",
    "iovalkey": "^0.4.0",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  }
}
